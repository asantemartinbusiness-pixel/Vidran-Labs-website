# Copy to .env.local for local overrides. Never commit real values.

# Canonical origin used for canonical URLs, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://vidran.net

# Search-engine indexing. Default OFF so review/preview deployments are never indexed.
# Set to "on" only for the approved production deployment.
SITE_INDEXING=off

# Content review mode. When "on" (default outside production builds), provisional
# content blocks are visibly badged so reviewers can see what still needs approval.
NEXT_PUBLIC_CONTENT_REVIEW=on
